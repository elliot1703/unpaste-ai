{
  "redirects": [
    {
      "source": "/training",
      "destination": "/team-training",
      "permanent": true
    },
    {
      "source": "/coaching",
      "destination": "/one-on-one",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/one-on-one/november",
      "destination": "/november-training/index.html"
    },
    {
      "source": "/((?!november-training|api|assets|images|brand|favicon|robots\\.txt|sitemap\\.xml|apple-touch-icon\\.png|favicon-16x16\\.png|favicon-32x32\\.png|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/november-training/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "functions": {
    "api/starter-kit.js": {
      "includeFiles": "private/starter-kit/**"
    }
  }
}
