{
  "rewrites": [
    {
      "source": "/((?!api|assets|images|brand|favicon|robots\\.txt|sitemap\\.xml|apple-touch-icon\\.png|favicon-16x16\\.png|favicon-32x32\\.png|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
